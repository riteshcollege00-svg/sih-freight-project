# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=freight_chartering
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL for SQLAlchemy / Psycopg / App Connectors
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freight_chartering

# Synthetic Data Generation Configuration (Hardened Demo Timeline)
DEMO_AS_OF_DATE=2026-09-18
DATA_HISTORY_DAYS=365
SIMULATION_SEED=42
RANDOM_SEED=42

# Fallback SQLite DB Path (for zero-dependency local testing when Postgres is offline)
SQLITE_DB_PATH=data/freight_chartering_demo.db
